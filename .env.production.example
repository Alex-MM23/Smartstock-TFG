# SmartStock AI - Production Environment Variables
# Copy to .env and fill in secure values

# Database (use strong passwords in production!)
DB_ROOT_PASSWORD=your_strong_root_password_here
DB_USER=smartstock
DB_PASSWORD=your_strong_db_password_here
DB_NAME=smartstock

# JWT Secret - MUST be changed in production!
# Generate with: openssl rand -base64 32
SECRET_KEY=your_very_long_random_secret_key_min_32_chars_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ML Model
MODEL_PATH=artifacts/demand_model.joblib

# Service level for safety stock (z-score)
# 1.645 = 95%, 1.96 = 97.5%, 2.33 = 99%
SERVICE_LEVEL_Z=1.645

# Environment
ENVIRONMENT=production