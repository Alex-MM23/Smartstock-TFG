# SmartStock TFG - Variables de entorno para Docker Compose
# Copia este archivo a .env y ajusta los valores

# Base de datos MySQL
DB_HOST=db
DB_PORT=3306
DB_USER=smartstock
DB_PASSWORD=smartstock_pass
DB_NAME=smartstock

# JWT Secret (CAMBIA EN PRODUCCIÓN - mínimo 32 caracteres)
SECRET_KEY=super-secret-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Modelo ML
MODEL_PATH=artifacts/demand_model.joblib

# Nivel de servicio para stock de seguridad (z-score: 1.645 = 95%, 1.96 = 97.5%, 2.33 = 99%)
SERVICE_LEVEL_Z=1.645

# Entorno
ENVIRONMENT=production